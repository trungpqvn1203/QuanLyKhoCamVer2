# =============================================
# Grain Warehouse - Biến môi trường PRODUCTION
# =============================================
# Trên server: cp .env.prod.example .env.prod && chmod 600 .env.prod rồi điền giá trị.
# KHÔNG commit .env.prod. Không đặt giá trị trong dấu nháy; không thêm comment cuối dòng.
# Dùng cho: docker compose -f infra/docker/docker-compose.prod.yml --env-file .env.prod ...

# --- Database (chỉ nằm trong mạng nội bộ Docker) ---
POSTGRES_DB=grain_warehouse
POSTGRES_USER=grain
# Tạo bằng: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Xác thực (ADR-0003) ---
# BẮT BUỘC, tối thiểu 32 byte ngẫu nhiên. Tạo bằng: openssl rand -base64 48
JWT_SECRET=
# true khi có HTTPS (tên miền). Chỉ đặt false khi demo tạm bằng http://<IP>
COOKIE_SECURE=true
# Tạo tài khoản Quản lý hệ thống đầu tiên khi bảng app_user còn trống. Mật khẩu tối thiểu 8 ký tự
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# --- Nginx ---
# Cổng mở ra ngoài. Trên server để 80; máy local nếu cổng 80 bận thì đổi, ví dụ 8088
HTTP_PORT=80
