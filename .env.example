# =============================================
# Grain Warehouse - Biến môi trường
# =============================================
# Copy file này thành .env (cùng thư mục gốc) và điền giá trị thực tế.
# KHÔNG commit file .env vào Git.
# Backend tự đọc file này qua spring.config.import (xem application.yml).
# Không đặt giá trị trong dấu nháy; không thêm comment cuối dòng.

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=grain_warehouse
POSTGRES_TEST_DB=grain_warehouse_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# --- Backend (Spring Boot) ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Xác thực (ADR-0003) ---
# Khóa ký access token, tối thiểu 32 byte ngẫu nhiên. Tạo bằng: openssl rand -base64 48
# Dev bỏ trống được (backend tự sinh khóa tạm); production BẮT BUỘC đặt
JWT_SECRET=
# true: cookie chỉ gửi qua HTTPS (trình duyệt vẫn cho phép http://localhost). Chỉ đặt false khi thật sự cần
COOKIE_SECURE=true
# Tạo tài khoản Quản lý hệ thống đầu tiên khi bảng app_user còn trống. Mật khẩu tối thiểu 8 ký tự
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api

# --- Docker ---
COMPOSE_PROJECT_NAME=grain-warehouse
